+// MARK: - TeleFlow: zalgo filter (visual only)
+
+private func teleflowIsZalgoScalar(_ scalar: Unicode.Scalar) -> Bool {
+    let value = scalar.value
+    let ranges: [ClosedRange<UInt32>] = [
+        0x0300...0x036F,
+        0x0483...0x0489,
+        0x0591...0x05BD,
+        0x05BF...0x05BF,
+        0x05C1...0x05C2,
+        0x0610...0x061A,
+        0x064B...0x065F,
+        0x0670...0x0670,
+        0x06D6...0x06DC,
+        0x06DF...0x06E4,
+        0x0711...0x0711,
+        0x0730...0x074A,
+        0x1AB0...0x1AFF,
+        0x1DC0...0x1DFF,
+        0x20D0...0x20F0,
+        0xFE20...0xFE2F
+    ]
+    for range in ranges {
+        if range.contains(value) {
+            return true
+        }
+    }
+    return false
+}
+
+/// Strips zalgo combining marks from the display text and shifts entity ranges so
+/// links, formatting and custom emoji keep pointing at the right characters.
+/// Only affects how the message is drawn on this device.
+private func teleflowZalgoSanitize(_ text: String, entities: [MessageTextEntity]?) -> (String, [MessageTextEntity]?) {
+    guard TeleFlowSettings.shared.zalgoFilter else {
+        return (text, entities)
+    }
+    var kept: [Unicode.Scalar] = []
+    var map: [Int] = []
+    var newUtf16 = 0
+    var removed = false
+    for scalar in text.unicodeScalars {
+        let width = UTF16.width(scalar)
+        if teleflowIsZalgoScalar(scalar) {
+            removed = true
+            for _ in 0..<width {
+                map.append(newUtf16)
+            }
+            continue
+        }
+        for _ in 0..<width {
+            map.append(newUtf16)
+        }
+        kept.append(scalar)
+        newUtf16 += width
+    }
+    map.append(newUtf16)
+    guard removed else {
+        return (text, entities)
+    }
+    let sanitized = String(String.UnicodeScalarView(kept))
+    var updatedEntities: [MessageTextEntity]?
+    if let list = entities {
+        var result: [MessageTextEntity] = []
+        for entity in list {
+            let originalStart = entity.range.lowerBound
+            let originalEnd = entity.range.upperBound
+            let clampedStart = min(originalStart, map.count - 1)
+            let clampedEnd = min(originalEnd, map.count - 1)
+            let newStart = map[clampedStart]
+            let newEnd = map[clampedEnd]
+            if newEnd > newStart {
+                result.append(MessageTextEntity(range: newStart..<newEnd, type: entity.type))
+            }
+        }
+        updatedEntities = result
+    }
+    return (sanitized, updatedEntities)
+}
