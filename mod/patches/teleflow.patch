+// MARK: - TeleFlow
+
+private func teleFlowShouldKeepDeleted(transaction: Transaction, messageId: MessageId) -> Bool {
+    let settings = TeleFlowSettings.shared
+    if !settings.saveDeletedMessages {
+        return false
+    }
+    guard let message = transaction.getMessage(messageId) else {
+        return false
+    }
+    // Our own messages that we deleted ourselves are already gone locally; anything still here was deleted elsewhere.
+    if message.flags.contains(.Incoming) == false && messageId.peerId.namespace != Namespaces.Peer.CloudUser {
+        return false
+    }
+    let kind: TeleFlowChatKind
+    if messageId.peerId.namespace == Namespaces.Peer.SecretChat {
+        kind = .secret
+    } else if let user = transaction.getPeer(messageId.peerId) as? TelegramUser {
+        kind = user.botInfo != nil ? .bot : .privateChat
+    } else if let channel = transaction.getPeer(messageId.peerId) as? TelegramChannel {
+        if case .broadcast = channel.info {
+            kind = .channel
+        } else {
+            kind = .group
+        }
+    } else {
+        kind = .group
+    }
+    return settings.shouldKeepDeletedMessages(in: kind)
+}
